        <mxCell id="_FymfXRlB6oFDUtI4zVs-79" value="&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;module-&amp;gt;&lt;font color=&quot;#cc99ff&quot;&gt;getNamedGlobal&lt;/font&gt;(&amp;lt;Name&amp;gt;)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;che recupera (se presente nel modulo) la variabile globale identificata&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;dal &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;nome &amp;lt;Name&amp;gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;&amp;lt;module&amp;gt;-&amp;gt;&lt;font color=&quot;#67ab9f&quot;&gt;getFunction&lt;/font&gt;(&amp;lt;Name&amp;gt;)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;che recupera (se presente nel modulo) la funzione identicata dal &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;nome&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;lt;Name&amp;gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;new &lt;font color=&quot;#7f00ff&quot;&gt;GlobalVariable&lt;/font&gt;(*&amp;lt;module&amp;gt;,&amp;lt;type&amp;gt;,false,&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;lt;linkage&amp;gt;,&amp;lt;Val&amp;gt;,&amp;lt;Name&amp;gt;)&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Questa istruzione genera una variabile globale di tipo &amp;lt;type&amp;gt;, nome&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;lt;Name&amp;gt; e valore iniziale &amp;lt;Val&amp;gt;. Il parametro &amp;lt;linkage&amp;gt; può essere a&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;sua volta denito nel seguente modo.&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;GlobalValue::LinkageTypes &amp;lt;linkage&amp;gt; =&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;GlobalValue::CommonLinkage&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
