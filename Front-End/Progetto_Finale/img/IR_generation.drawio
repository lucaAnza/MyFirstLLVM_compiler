        <mxCell id="_FymfXRlB6oFDUtI4zVs-33" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;- &lt;b style=&quot;font-size: 9px;&quot;&gt;BasicBlock::&lt;font color=&quot;#67ab9f&quot;&gt;Create&lt;/font&gt;(*&amp;lt;context&amp;gt;, &amp;lt;Label&amp;gt; , &amp;lt;function&amp;gt; )&lt;/b&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;che crea un Basic Block non ancora posizionato o (nel caso sia&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;presente il terzo parametro) posizionato in fondo agli attuali blocchi&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;della funzione &amp;lt;function&amp;gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;- &lt;b style=&quot;font-size: 9px;&quot;&gt;&amp;lt;function&amp;gt;-&amp;gt;&lt;font color=&quot;#ff9933&quot;&gt;insert&lt;/font&gt;(&amp;lt;function&amp;gt;-&amp;gt;end(), &amp;lt;BB&amp;gt;)&lt;/b&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;che inserisce il Basic Block &amp;lt;BB&amp;gt; in coda ai blocchi che già &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;concorrono&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;alla denizione della funzione &amp;lt;function&amp;gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;- &lt;b style=&quot;font-size: 9px;&quot;&gt;&amp;lt;function&amp;gt;-&amp;gt;&lt;font color=&quot;#3399ff&quot;&gt;getEntryBlock&lt;/font&gt;().begin()&lt;/b&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;che denisce, come punto di inserimento del codice (da passare al&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;builder), l&#39;inizio del primo blocco (chiamato appunto entry block ) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;della funzione &amp;lt;function&amp;gt;.&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;- &lt;b style=&quot;font-size: 9px;&quot;&gt;&amp;lt;builder&amp;gt;-&amp;gt;&lt;font color=&quot;#3399ff&quot;&gt;GetInsertBlock&lt;/font&gt;()&lt;/b&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;che recupera (il riferimento a) il Basic Block dove viene &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;correntemente inserito il codice.&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;- &lt;b style=&quot;font-size: 9px;&quot;&gt;&amp;lt;builder&amp;gt;-&amp;gt;&lt;font color=&quot;#ff9933&quot;&gt;SetInsertPoint&lt;/font&gt;(&amp;lt;BB&amp;gt;)&lt;/b&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;che istruisce il builder ad inserire codice nel Basic Block &amp;lt;BB&amp;gt;.&lt;/font&gt;&lt;div style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 9px;&quot;&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
